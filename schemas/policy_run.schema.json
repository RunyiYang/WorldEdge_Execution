{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:worldedge:schema:policy_run:1.0.0",
  "title": "WorldEdge fixed ten-round policy run",
  "$comment": "All ten schedule slots must appear, including unattempted zero outcomes. Use all paired admitted bundles. Infrastructure-incomplete runs must not silently enter the headline success denominator or be replaced by best-of retries. The aggregation script must apply the fixed retry/accounting policy and cluster by independent source group. No policy-level success handler may mutate object state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "world_bundle_id",
    "world_bundle_ref",
    "source_group_id",
    "model_id",
    "model_manifest_ref",
    "setting",
    "embodiment_id",
    "environment_seed",
    "policy_seed",
    "status",
    "termination_reason",
    "simulator_version",
    "evaluator_version",
    "state_source",
    "success_source",
    "rounds"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "world_bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "world_bundle_ref": {
      "$ref": "#/$defs/pinnedArtifactRef"
    },
    "source_group_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_manifest_ref": {
      "$ref": "#/$defs/pinnedArtifactRef"
    },
    "setting": {
      "enum": [
        "manipulation",
        "mobile_manipulation"
      ]
    },
    "embodiment_id": {
      "enum": [
        "dual_arx_x5",
        "lift2_r5a"
      ]
    },
    "environment_seed": {
      "type": "integer",
      "minimum": 0
    },
    "policy_seed": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "completed",
        "incomplete_infrastructure",
        "terminated_policy"
      ]
    },
    "termination_reason": {
      "type": "string",
      "minLength": 1
    },
    "simulator_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "state_source": {
      "const": "simulator"
    },
    "success_source": {
      "const": "shadow_goal_evaluator"
    },
    "state_interventions_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/pinnedArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "rounds": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 1
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 2
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 3
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 4
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 5
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 6
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 7
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 8
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 9
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/round"
            },
            {
              "properties": {
                "round_index": {
                  "const": 10
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "setting": {
            "const": "manipulation"
          }
        },
        "required": [
          "setting"
        ]
      },
      "then": {
        "properties": {
          "embodiment_id": {
            "const": "dual_arx_x5"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "setting": {
            "const": "mobile_manipulation"
          }
        },
        "required": [
          "setting"
        ]
      },
      "then": {
        "properties": {
          "embodiment_id": {
            "const": "lift2_r5a"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "terminated_policy"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "rounds": {
            "items": {
              "if": {
                "properties": {
                  "attempted": {
                    "const": true
                  }
                },
                "required": [
                  "attempted"
                ]
              },
              "then": {
                "properties": {
                  "reason": {
                    "enum": [
                      "goal_met",
                      "goal_not_met",
                      "task_deadline",
                      "episode_deadline",
                      "invalid_action",
                      "policy_error"
                    ]
                  },
                  "final_state_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "executed_action_log_ref": {
                    "$ref": "#/$defs/pinnedArtifactRef"
                  },
                  "shadow_goal_trace_ref": {
                    "$ref": "#/$defs/pinnedArtifactRef"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete_infrastructure"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "rounds": {
            "contains": {
              "properties": {
                "reason": {
                  "enum": [
                    "infrastructure_interruption",
                    "unattempted_after_infrastructure_failure"
                  ]
                }
              },
              "required": [
                "reason"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "terminated_policy"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "rounds": {
            "items": {
              "properties": {
                "reason": {
                  "not": {
                    "enum": [
                      "infrastructure_interruption",
                      "unattempted_after_infrastructure_failure"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "pinnedArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Resolvable local or repository artifact path. Do not put secret-bearing URLs here."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_index",
        "task_id",
        "attempted",
        "success",
        "reason",
        "instruction_ref",
        "instruction_issued_at_s",
        "deadline_at_s",
        "deadline_clock",
        "initial_state_sha256",
        "final_state_sha256",
        "executed_action_log_ref",
        "shadow_goal_trace_ref"
      ],
      "properties": {
        "round_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "attempted": {
          "type": "boolean"
        },
        "success": {
          "type": "integer",
          "enum": [
            0,
            1
          ],
          "description": "A binary outcome from the independent simulator-state evaluator. Unattempted and infrastructure-interrupted slots must be zero."
        },
        "reason": {
          "enum": [
            "goal_met",
            "goal_not_met",
            "task_deadline",
            "episode_deadline",
            "invalid_action",
            "policy_error",
            "infrastructure_interruption",
            "unattempted_after_policy_termination",
            "unattempted_after_infrastructure_failure",
            "unattempted_after_budget_exhaustion"
          ]
        },
        "reason_details": {
          "type": "string"
        },
        "instruction_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/pinnedArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "instruction_issued_at_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_at_s": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_clock": {
          "enum": [
            "simulation_seconds",
            "wall_seconds"
          ]
        },
        "initial_state_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "final_state_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "executed_action_log_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/pinnedArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "shadow_goal_trace_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/pinnedArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "$comment": "Runtime checks must verify deadline_at_s > instruction_issued_at_s, consistent clock/rate conversion, matching task IDs, actual action timestamps, and predicate traces computed from actual simulator state. A skill's success return is insufficient. Never silently discard an unattempted slot.",
      "allOf": [
        {
          "if": {
            "properties": {
              "attempted": {
                "const": false
              }
            },
            "required": [
              "attempted"
            ]
          },
          "then": {
            "properties": {
              "success": {
                "const": 0
              },
              "reason": {
                "enum": [
                  "unattempted_after_policy_termination",
                  "unattempted_after_infrastructure_failure",
                  "unattempted_after_budget_exhaustion"
                ]
              },
              "instruction_ref": {
                "type": "null"
              },
              "instruction_issued_at_s": {
                "type": "null"
              },
              "deadline_at_s": {
                "type": "null"
              },
              "initial_state_sha256": {
                "type": "null"
              },
              "final_state_sha256": {
                "type": "null"
              },
              "executed_action_log_ref": {
                "type": "null"
              },
              "shadow_goal_trace_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attempted": {
                "const": true
              }
            },
            "required": [
              "attempted"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "goal_met",
                  "goal_not_met",
                  "task_deadline",
                  "episode_deadline",
                  "invalid_action",
                  "policy_error",
                  "infrastructure_interruption"
                ]
              },
              "instruction_ref": {
                "$ref": "#/$defs/pinnedArtifactRef"
              },
              "instruction_issued_at_s": {
                "type": "number",
                "minimum": 0
              },
              "deadline_at_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "initial_state_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "success": {
                "const": 1
              }
            },
            "required": [
              "success"
            ]
          },
          "then": {
            "properties": {
              "attempted": {
                "const": true
              },
              "reason": {
                "const": "goal_met"
              },
              "final_state_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "executed_action_log_ref": {
                "$ref": "#/$defs/pinnedArtifactRef"
              },
              "shadow_goal_trace_ref": {
                "$ref": "#/$defs/pinnedArtifactRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "goal_met"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "success": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "infrastructure_interruption"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "success": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
}
